<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if metaTitle %}{{ metaTitle }}{% elif title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ description or site.defaultDescription }}" />
    <meta name="theme-color" content="{{ site.themeColor }}" />
    {% if robots %}<meta name="robots" content="{{ robots }}" />{% elif noindex %}<meta name="robots" content="noindex" />{% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    {# Fonts: DM Serif Display (display) and Manrope (UI), display=swap. #}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@300;400;500;600;700&display=swap"
    />

    {# Versioned by content hash (src/_data/cssVersion.js) so the immutable
       one-year cache on /css/* can never serve stale styles after a deploy. #}
    <link rel="stylesheet" href="/css/main.css?v={{ cssVersion }}" />
    <link rel="manifest" href="/site.webmanifest" />
    {# Icons come from the brand folder on the CDN (the teal life-ring mark). These
       previously pointed at /favicon.svg, /favicon.ico and /apple-touch-icon.png,
       none of which exist in the build, so every page shipped three 404s and no
       favicon. The .ico link is gone rather than repointed: browsers request
       /favicon.ico at the root on their own, and declaring one that 404s is worse
       than declaring none. Sources are listed in IMAGE_MANIFEST.md. #}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ site.icons.favicon32 }}" />
    <link rel="icon" type="image/png" sizes="512x512" href="{{ site.icons.favicon512 }}" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{ site.icons.appleTouch }}" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {% include "components/header.njk" %}

    <main id="main">
      {{ content | safe }}
    </main>

    {% include "components/footer.njk" %}

    <script src="/js/menu.js" defer></script>

    {# Calendly's widget script, loaded once and only on pages whose front matter
       sets `calendly: true` (currently /, /contact, /get-started). Keeping it out
       of the global bundle means the other 28 pages pay nothing for it. Async, so
       it never blocks parsing; the embed reserves its own height in CSS, so a slow
       third party cannot shift the layout. #}
    {% if calendly %}<script src="https://assets.calendly.com/assets/external/widget.js" async></script>{% endif %}
  </body>
</html>
