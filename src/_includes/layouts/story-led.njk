---
layout: layouts/base.njk
---
{#
  story-led: page template for emotionally narrative topics (grief, infidelity,
  conflict-resolution, faith-based, about, kay-wenger, beach-therapy). Leans on
  Kay's voice early. See COMPONENT_COVERAGE.md for the full mapping.

  Keys (all optional unless marked required; absent keys render nothing):

    crumbs      [{label, url?}]
    hero        { eyebrow, title (required), titleEmphasis?, lead?, variant?,
                  image?, trust?, gold?, ctaLabel?, ctaHref?, secondaryCta?,
                  treatment?, display?, displayEmphasis? }
                Hero default: variant "bg" (full-bleed photo with the directional
                gradient veil, the Beach Therapy treatment). Override per page via
                hero.variant ("split" | "center").
                treatment "swap" drops the title to eyebrow scale and puts
                hero.display in the display slot. hero.eyebrow is ignored under
                it, since the title takes the eyebrow's place. See the treatment
                docs in components/sections.njk for the accessibility tradeoff:
                the display line is deliberately not in the heading outline.
    lead        string | string[]
    kay         founderNote opts: { eyebrow?, variant? (founder | note),
                  portrait{src,alt}, name?, nameEmphasis?, role?, quote?,
                  quoteEmphasis?, body[], creds?, statement?, sign?,
                  cta?{href,label}, tone? }
                Placed early: this template leans on her voice. cta closes the
                block with a teal text link, for routing onward to her own page.
    crossSell   { eyebrow, title, titleEmphasis?, body, href, label, image?,
                  reverse?, imageWeight?, anchorLine?, pullQuote?, tone? }
                Defaults to the image-dominant weight for the narrative feel.
    quote       { text, attribution?, foam? }   foam defaults ON in this template
    shapes      { eyebrow, title, titleEmphasis?, lead?, items[{term, detail}] }
                "what this often looks like" as a definition list, OR:
    journey     { eyebrow, title, titleEmphasis?, lead?, steps[{title, body}] }
                the same beat as a numbered timeline; provide shapes OR journey
    next        { eyebrow, title, titleEmphasis?, columns?, cards[], tone? }
    faq         { eyebrow, title, items[{q,a}] OR tags[], limit?, variant? }
                items is a literal list; tags pulls from src/_data/faq.json
                (the FAQ answer engine) instead, by tag, via the resolveFaq filter.
                Either way also emits matching faqSchema.
    support     true renders the crisis support-resources block
    cta         { title, titleEmphasis?, text?, note?, watermark?, tagline?,
                  href?, label?, variant? }   tagline: true uses site.tagline
    service     { name, serviceType, description, areaServed? }

  The page BODY renders at the content slot after the shapes/journey block.

  Enforced here, not by convention: the CTA band is always tone sand (the navy
  band must never sit directly above the navy footer), the hero renders the
  page's only h1, the hero CTA is navy unless the page opts into hero.gold.
  Facts come from front matter and site data, never hardcoded. No em dashes.
#}
{% import "components/ui.njk" as ui %}
{% import "components/sections.njk" as s %}
{% set faqResolvedItems = faq | resolveFaq(faqEntries) %}

{% if crumbs %}{{ s.breadcrumbs(crumbs) }}{% endif %}

{{ s.hero({
  eyebrow: hero.eyebrow,
  title: hero.title,
  titleEmphasis: hero.titleEmphasis,
  treatment: hero.treatment,
  display: hero.display,
  displayEmphasis: hero.displayEmphasis,
  lead: hero.lead,
  variant: hero.variant or "bg",
  image: hero.image,
  trust: hero.trust,
  cta: { href: hero.ctaHref or site.booking.getStartedPath, label: hero.ctaLabel or site.booking.navLabel, gold: hero.gold },
  secondaryCta: hero.secondaryCta
}) }}

{% if lead %}{{ s.lead({ text: lead }) }}{% endif %}

{% if kay %}
  {{ s.founderNote({
    eyebrow: kay.eyebrow,
    variant: kay.variant,
    portrait: kay.portrait,
    name: kay.name,
    nameEmphasis: kay.nameEmphasis,
    role: kay.role,
    quote: kay.quote,
    quoteEmphasis: kay.quoteEmphasis,
    body: kay.body,
    creds: kay.creds,
    statement: kay.statement,
    sign: kay.sign,
    cta: kay.cta,
    tone: kay.tone
  }) }}
{% endif %}

{% if crossSell %}
  {{ s.promoCallout({
    eyebrow: crossSell.eyebrow,
    title: crossSell.title,
    titleEmphasis: crossSell.titleEmphasis,
    body: crossSell.body,
    cta: { href: crossSell.href, label: crossSell.label },
    image: crossSell.image,
    reverse: crossSell.reverse,
    imageWeight: crossSell.imageWeight or "image",
    anchorLine: crossSell.anchorLine,
    pullQuote: crossSell.pullQuote,
    tone: crossSell.tone
  }) }}
{% endif %}

{% if quote %}{{ s.pullQuote({ quote: quote.text, attribution: quote.attribution, foam: quote.foam if quote.foam is defined else true }) }}{% endif %}

{% if shapes %}
  {{ s.definitionList({ eyebrow: shapes.eyebrow, title: shapes.title, titleEmphasis: shapes.titleEmphasis, lead: shapes.lead, items: shapes.items }) }}
{% elif journey %}
  {{ s.steps({ eyebrow: journey.eyebrow, title: journey.title, titleEmphasis: journey.titleEmphasis, lead: journey.lead, steps: journey.steps }) }}
{% endif %}

{# Content slot: page-specific sections composed from the library land here. #}
{{ content | safe }}

{% if next %}
  {{ s.pointCards({ eyebrow: next.eyebrow, title: next.title, columns: next.columns or 2, cards: next.cards, tone: next.tone or "sand" }) }}
{% endif %}

{% if faqResolvedItems | length %}{{ s.faq({ eyebrow: faq.eyebrow, title: faq.title, items: faqResolvedItems, variant: faq.variant }) }}{% endif %}

{% if support %}
  {% call ui.section({ tone: "paper", width: "narrow" }) %}
    {% set onFooter = false %}
    {% include "components/support-resources.njk" %}
  {% endcall %}
{% endif %}

{{ s.ctaBand({
  variant: cta.variant or "center",
  tone: "sand",
  watermark: cta.watermark,
  title: cta.title,
  titleEmphasis: cta.titleEmphasis,
  text: cta.text,
  note: cta.note,
  tagline: (site.tagline if cta.tagline == true else cta.tagline),
  cta: { href: cta.href or site.booking.getStartedPath, label: cta.label or site.booking.navLabel }
}) }}

{% if service %}
  {{ s.serviceSchema({
    name: service.name,
    serviceType: service.serviceType,
    description: service.description,
    url: page.url,
    business: { url: site.url, name: site.name, telephone: site.nap.telephone },
    areaServed: service.areaServed
  }) }}
{% endif %}
{% if crumbs %}{{ s.breadcrumbSchema(crumbs, site.url) }}{% endif %}
{% if faqResolvedItems | length %}{{ s.faqSchema(faqResolvedItems) }}{% endif %}
